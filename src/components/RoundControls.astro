---
// RoundControls.astro - Barra de acciones rápidas de la mesa
---

<div class="controls-container">
  <!-- Botón Principal: Cerrar Mano -->
  <button id="btn-open-close-hand" class="btn btn-primary btn-action-main" aria-label="Anotar y cerrar mano">
    <span class="btn-main-icon">📝</span>
    <span class="btn-main-text">Cerrar Mano</span>
  </button>

  <div class="secondary-actions">
    <!-- Botón Deshacer última mano -->
    <button
      id="btn-undo-hand"
      class="btn btn-secondary action-sub-btn"
      disabled
      title="Deshacer la última mano registrada"
      aria-label="Deshacer mano"
    >
      <span class="sub-btn-icon">↩️</span>
      <span class="sub-btn-text">Deshacer</span>
    </button>

    <!-- Botón Ver Historial -->
    <button
      id="btn-open-history"
      class="btn btn-secondary action-sub-btn"
      title="Ver historial completo de manos"
      aria-label="Historial de manos"
    >
      <span class="sub-btn-icon">📜</span>
      <span class="sub-btn-text">Historial</span>
      <span class="history-count-badge" id="history-badge-count">0</span>
    </button>
  </div>
</div>

<style>
  .controls-container {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    margin-top: auto;
  }

  .btn-action-main {
    width: 100%;
    height: 56px;
    font-size: 1.15rem;
    font-weight: 800;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #10b981 0%, #047857 100%);
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    letter-spacing: 0.01em;
  }

  .btn-action-main:disabled {
    opacity: 0.5;
    pointer-events: none;
    filter: grayscale(0.6);
  }

  .btn-main-icon {
    font-size: 1.3rem;
  }

  .secondary-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .action-sub-btn {
    height: 44px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    position: relative;
  }

  .action-sub-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none !important;
  }

  .sub-btn-icon {
    font-size: 1rem;
  }

  .history-count-badge {
    background: var(--mano-gold);
    color: #1a1500;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    min-width: 18px;
    text-align: center;
  }
</style>

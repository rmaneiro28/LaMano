---
// ScoreBoard.astro - Planilla de anotación manual tradicional en dos columnas
---

<section class="scoresheet-container" aria-label="Planilla de Anotación Manual">
  <!-- Cabecera de la Planilla -->
  <div class="scoresheet-header">
    <div class="column-header team-a-header">
      <span class="team-dot dot-a"></span>
      <h3 class="team-title" id="display-team-a-name">Nosotros</h3>
    </div>

    <div class="scoresheet-center-meta">
      <div class="meta-pill">
        <span class="meta-label">MANO</span>
        <strong class="meta-val tabular-nums" id="display-current-round">1</strong>
      </div>
      <div class="meta-pill meta-target" id="display-target-goal">
        <span class="meta-label">META</span>
        <strong class="meta-val tabular-nums" id="display-target-number">100</strong>
      </div>
    </div>

    <div class="column-header team-b-header">
      <span class="team-dot dot-b"></span>
      <h3 class="team-title" id="display-team-b-name">Ellos</h3>
    </div>
  </div>

  <!-- Indicadores de Serie -->
  <div class="series-tracker-row">
    <div class="series-side side-a">
      <strong class="series-score-num" id="series-score-num-a">0</strong>
      <div class="series-pips-mini" id="series-indicator-a"></div>
    </div>
    <span class="series-mode-tag" id="series-mode-tag">Bo3 · P1</span>
    <div class="series-side side-b">
      <div class="series-pips-mini" id="series-indicator-b"></div>
      <strong class="series-score-num" id="series-score-num-b">0</strong>
    </div>
  </div>

  <!-- Línea divisoria superior del cuaderno -->
  <div class="notebook-double-line"></div>

  <!-- Cuerpo de las dos columnas con las partidas registradas -->
  <div class="scoresheet-body-wrapper" id="scoresheet-scroll-area">
    <div class="scoresheet-body" id="scoresheet-rows">
      <!-- Se inyecta dinámicamente cada renglón de partida -->
      <div class="scoresheet-empty-state" id="scoresheet-empty-state">
        <div class="empty-row-guide">
          <span class="empty-cell">—</span>
          <span class="empty-divider"></span>
          <span class="empty-cell">—</span>
        </div>
        <p class="empty-note">Anotación manual lista. Cierra la 1ª mano para registrar los puntos.</p>
      </div>
    </div>
  </div>

  <!-- Línea clásica de suma tradicional de libreta/pizarra -->
  <div class="notebook-sum-line"></div>

  <!-- Pie de la Planilla: Totales acumulados por columna -->
  <div class="scoresheet-footer">
    <!-- Total Equipo A -->
    <div class="total-column team-a-total">
      <div class="total-header-row">
        <span class="total-caption">TOTAL</span>
        <span class="score-target-text" id="target-diff-team-a">Faltan 100</span>
      </div>
      <div class="total-value-row">
        <span class="total-score tabular-nums" id="score-team-a">0</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill fill-a" id="progress-team-a" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Divisor vertical del pie -->
    <div class="footer-center-divider">
      <span class="vs-badge">VS</span>
    </div>

    <!-- Total Equipo B -->
    <div class="total-column team-b-total">
      <div class="total-header-row">
        <span class="total-caption">TOTAL</span>
        <span class="score-target-text" id="target-diff-team-b">Faltan 100</span>
      </div>
      <div class="total-value-row">
        <span class="total-score tabular-nums" id="score-team-b">0</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill fill-b" id="progress-team-b" style="width: 0%;"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .scoresheet-container {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #13221d 0%, #0d1a16 100%);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 0.75rem 0.85rem 0.65rem;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  /* Indicadores de Serie */
  .series-tracker-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0;
    margin-bottom: 0.25rem;
  }

  .series-side {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .side-b {
    flex-direction: row-reverse;
  }

  .series-score-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1;
  }

  .series-pips-mini {
    display: flex;
    gap: 0.2rem;
  }

  :global(.series-pip-mini) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    display: inline-block;
    transition: background 0.25s ease;
  }

  :global(.series-pip-mini.won-a) {
    background: var(--team-a-base);
    border-color: var(--team-a-base);
    box-shadow: 0 0 5px rgba(59, 130, 246, 0.5);
  }

  :global(.series-pip-mini.won-b) {
    background: var(--team-b-base, #f97316);
    border-color: var(--team-b-base, #f97316);
    box-shadow: 0 0 5px rgba(249, 115, 22, 0.5);
  }

  .series-mode-tag {
    font-size: 0.64rem;
    font-weight: 800;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  /* Cabecera con 2 columnas y metadata al centro */
  .scoresheet-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .column-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .team-a-header {
    justify-content: flex-start;
  }

  .team-b-header {
    justify-content: flex-end;
    flex-direction: row-reverse;
  }

  .team-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-a {
    background: var(--team-a-base);
    box-shadow: 0 0 6px var(--team-a-glow);
  }

  .dot-b {
    background: var(--team-b-base);
    box-shadow: 0 0 6px var(--team-b-glow);
  }

  .team-title {
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .team-a-header .team-title {
    color: #93c5fd;
  }

  .team-b-header .team-title {
    color: #fdba74;
  }

  .scoresheet-center-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.45rem;
    min-width: 44px;
    line-height: 1.1;
  }

  .meta-label {
    font-size: 0.55rem;
    font-weight: 800;
    color: var(--text-subtle);
    letter-spacing: 0.06em;
  }

  .meta-val {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--mano-gold);
  }

  .meta-target .meta-val {
    color: var(--text-main);
  }

  /* Doble línea de cuaderno superior */
  .notebook-double-line {
    width: 100%;
    height: 3px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 0.35rem;
  }

  /* Área scrolleable de renglones de partidas */
  .scoresheet-body-wrapper {
    max-height: 155px;
    min-height: 90px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    padding-right: 2px;
  }

  .scoresheet-body-wrapper::-webkit-scrollbar {
    width: 4px;
  }

  .scoresheet-body-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  .scoresheet-body {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Renglones inyectados de cada partida */
  :global(.scoresheet-row) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.32rem 0.4rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    transition: background-color 0.15s ease;
  }

  :global(.scoresheet-row:nth-child(even)) {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.scoresheet-row.latest-round) {
    background: rgba(251, 191, 36, 0.08);
    border-bottom: 1px solid rgba(251, 191, 36, 0.25);
  }

  :global(.score-cell) {
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1;
    min-height: 1.3rem;
  }

  :global(.score-cell.cell-team-a) {
    justify-content: flex-start;
    padding-left: 0.5rem;
  }

  :global(.score-cell.cell-team-b) {
    justify-content: flex-end;
    padding-right: 0.5rem;
  }

  :global(.score-value-tag) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  :global(.score-points-a) {
    color: #60a5fa;
    font-weight: 800;
  }

  :global(.score-points-b) {
    color: #fb923c;
    font-weight: 800;
  }

  :global(.score-sub-accum) {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-subtle);
    opacity: 0.85;
  }

  :global(.score-dash) {
    color: rgba(255, 255, 255, 0.18);
    font-weight: 400;
  }

  :global(.row-round-badge) {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-subtle);
    background: rgba(0, 0, 0, 0.3);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    letter-spacing: 0.03em;
  }

  /* Estado vacío */
  .scoresheet-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.5rem;
    gap: 0.5rem;
  }

  .empty-row-guide {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    width: 100%;
    align-items: center;
    opacity: 0.25;
    padding: 0.3rem 0;
  }

  .empty-cell {
    text-align: center;
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  .empty-divider {
    height: 18px;
    background: rgba(255, 255, 255, 0.2);
  }

  .empty-note {
    font-size: 0.73rem;
    color: var(--text-subtle);
    text-align: center;
    font-style: italic;
  }

  /* Línea divisoria de suma tradicional de libreta */
  .notebook-sum-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(59, 130, 246, 0.6) 0%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(249, 115, 22, 0.6) 100%
    );
    margin: 0.4rem 0 0.45rem;
  }

  /* Pie con Totales */
  .scoresheet-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.15rem;
  }

  .total-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .team-a-total {
    align-items: flex-start;
  }

  .team-b-total {
    align-items: flex-end;
  }

  .total-header-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .team-a-total .total-header-row {
    justify-content: flex-start;
  }

  .team-b-total .total-header-row {
    justify-content: flex-end;
    flex-direction: row-reverse;
  }

  .total-caption {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .score-target-text {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-subtle);
  }

  .total-value-row {
    display: flex;
    align-items: baseline;
    margin: 0.05rem 0;
  }

  .total-score {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .team-a-total .total-score {
    color: #60a5fa;
    text-shadow: 0 0 14px rgba(59, 130, 246, 0.45);
  }

  .team-b-total .total-score {
    color: #fb923c;
    text-shadow: 0 0 14px rgba(249, 115, 22, 0.45);
  }

  .progress-bar-bg {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-top: 0.25rem;
  }

  .progress-bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fill-a {
    background: linear-gradient(90deg, #2563eb, #60a5fa);
  }

  .fill-b {
    background: linear-gradient(90deg, #ea580c, #fb923c);
  }

  .footer-center-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.15rem;
  }

  .vs-badge {
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--text-subtle);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-full);
  }

  @media (min-width: 480px) {
    .scoresheet-body-wrapper {
      max-height: 175px;
    }
    .total-score {
      font-size: 2.5rem;
    }
    .team-title {
      font-size: 1.05rem;
    }
  }
</style>

---
// VictoryModal.astro - Modal de fin de partida con marcador de serie y confetti
---

<div class="modal-overlay" id="victory-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title-victory">
  <div class="modal-sheet victory-sheet">
    <canvas id="confetti-canvas" class="confetti-canvas"></canvas>

    <div class="victory-header">
      <div class="trophy-badge float-mano" id="victory-trophy-icon">🏆</div>
      <h2 id="modal-title-victory" class="victory-title">¡Partida Finalizada!</h2>
      <p class="victory-winner-team" id="victory-winner-name">Equipo Campeón</p>
    </div>

    <!-- Marcador de la Serie -->
    <div class="series-scoreboard" id="series-scoreboard">
      <div class="series-header">
        <span class="series-label" id="series-mode-label">Mejor de 3</span>
        <span class="series-game-tag" id="series-game-tag">Partida 1</span>
      </div>
      <div class="series-teams-row">
        <div class="series-team series-team-a">
          <span class="series-team-name" id="series-team-a-name">Nosotros</span>
          <div class="series-pips" id="series-pips-a">
            <!-- Puntos de la serie se renderizan por JS -->
          </div>
          <span class="series-wins-count" id="series-wins-a">0</span>
        </div>
        <span class="series-dash">—</span>
        <div class="series-team series-team-b">
          <span class="series-wins-count" id="series-wins-b">0</span>
          <div class="series-pips" id="series-pips-b"></div>
          <span class="series-team-name" id="series-team-b-name">Ellos</span>
        </div>
      </div>
    </div>

    <!-- Marcador Final de la Partida -->
    <div class="final-score-banner">
      <div class="final-team">
        <span class="final-team-label" id="final-team-a-name">Nosotros</span>
        <strong class="final-score-val tabular-nums" id="final-score-a">100</strong>
      </div>
      <span class="score-vs-divider">VS</span>
      <div class="final-team">
        <span class="final-team-label" id="final-team-b-name">Ellos</span>
        <strong class="final-score-val tabular-nums" id="final-score-b">78</strong>
      </div>
    </div>

    <!-- Resumen Estadístico -->
    <div class="stats-card">
      <h3 class="stats-title">Estadísticas de la Partida</h3>

      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">Total de Manos</span>
          <strong class="stat-value tabular-nums" id="stat-total-hands">0</strong>
        </div>
        <div class="stat-item">
          <span class="stat-label">Diferencia Final</span>
          <strong class="stat-value tabular-nums" id="stat-diff-points">0 pts</strong>
        </div>
        <div class="stat-item">
          <span class="stat-label">Manos Ganadas Eq. A</span>
          <strong class="stat-value tabular-nums" id="stat-hands-team-a">0</strong>
        </div>
        <div class="stat-item">
          <span class="stat-label">Manos Ganadas Eq. B</span>
          <strong class="stat-value tabular-nums" id="stat-hands-team-b">0</strong>
        </div>
        <div class="stat-item">
          <span class="stat-label">Mano con Más Puntos</span>
          <strong class="stat-value tabular-nums" id="stat-max-points">0 pts</strong>
        </div>
        <div class="stat-item">
          <span class="stat-label">Promedio Pts / Mano</span>
          <strong class="stat-value tabular-nums" id="stat-avg-points">0</strong>
        </div>
      </div>
    </div>

    <!-- Historial de Jugadas -->
    <div class="victory-history-card">
      <h3 class="stats-title">Registro de Jugadas</h3>
      <div class="victory-history-list" id="victory-history-list">
        <!-- El historial de manos se inyectará aquí -->
      </div>
    </div>

    <!-- Acciones Finales -->
    <div class="victory-actions">
      <!-- Botón "Siguiente partida" (visible cuando la serie no ha terminado) -->
      <button type="button" class="btn btn-gold btn-next-game" id="btn-next-game" style="display:none;">
        <span class="btn-icon-symbol">▶</span>
        <span id="btn-next-game-label">Siguiente Partida →</span>
      </button>

      <!-- Botón "Revancha / Nueva serie" (visible cuando la serie terminó) -->
      <button type="button" class="btn btn-gold btn-rematch" id="btn-rematch" style="display:none;">
        <span class="btn-icon-symbol">🔄</span>
        <span>Nueva Serie (Mismos Jugadores)</span>
      </button>

      <button type="button" class="btn btn-secondary btn-new-game" id="btn-new-game-from-victory">
        <span class="btn-icon-symbol">⚙️</span>
        <span>Configurar Nueva Serie</span>
      </button>
    </div>
  </div>
</div>

<style>
  .victory-sheet {
    position: relative;
    overflow-y: auto;
    text-align: center;
    max-height: 92vh;
    padding-top: 2rem;
    gap: 0.75rem;
  }

  .confetti-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99998;
  }

  .victory-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    position: relative;
    z-index: 2;
  }

  .trophy-badge {
    font-size: 3.2rem;
    line-height: 1;
    filter: drop-shadow(0 0 15px var(--mano-glow));
    margin-bottom: 0.25rem;
  }

  .victory-title {
    font-size: 1.5rem;
    color: var(--text-main);
  }

  .victory-winner-team {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--mano-gold);
    text-shadow: 0 0 12px var(--mano-glow);
  }

  /* Marcador de Serie */
  .series-scoreboard {
    background: rgba(0, 0, 0, 0.4);
    border: 1.5px solid rgba(251, 191, 36, 0.35);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    z-index: 2;
  }

  .series-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .series-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--mano-gold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .series-game-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .series-teams-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .series-team {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: 1;
  }

  .series-team-a {
    justify-content: flex-start;
  }

  .series-team-b {
    justify-content: flex-end;
  }

  .series-team-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .series-pips {
    display: flex;
    gap: 0.2rem;
    align-items: center;
  }

  /* Los pips se generan por JS */
  :global(.series-pip) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.2);
    display: inline-block;
    transition: background 0.2s ease;
  }

  :global(.series-pip.won-a) {
    background: var(--team-a-base);
    border-color: var(--team-a-base);
    box-shadow: 0 0 6px rgba(59,130,246,0.5);
  }

  :global(.series-pip.won-b) {
    background: var(--team-b-base, #f97316);
    border-color: var(--team-b-base, #f97316);
    box-shadow: 0 0 6px rgba(249,115,22,0.5);
  }

  .series-wins-count {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1;
    min-width: 1.5rem;
    text-align: center;
  }

  .series-dash {
    font-size: 1.4rem;
    color: var(--text-subtle);
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Marcador Final */
  .final-score-banner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: rgba(0, 0, 0, 0.35);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1rem;
    z-index: 2;
  }

  .final-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .final-team-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .final-score-val {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1;
  }

  .score-vs-divider {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-subtle);
  }

  /* Estadísticas */
  .stats-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    z-index: 2;
  }

  .stats-title {
    font-size: 0.82rem;
    color: var(--mano-gold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem 0.85rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    font-family: var(--font-display);
  }

  /* Acciones */
  .victory-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.25rem;
    position: relative;
    z-index: 2;
  }

  .btn-next-game {
    height: 54px;
    font-size: 1.1rem;
    font-weight: 800;
    border-radius: var(--radius-md);
    animation: pulse-gold 2s infinite;
  }

  @keyframes pulse-gold {
    0%, 100% { box-shadow: 0 4px 16px rgba(251, 191, 36, 0.4); }
    50% { box-shadow: 0 4px 28px rgba(251, 191, 36, 0.7); }
  }

  .btn-rematch {
    height: 54px;
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: var(--radius-md);
  }

  .btn-new-game {
    height: 46px;
  }
  
  .victory-history-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    z-index: 2;
  }
  
  .victory-history-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 200px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }
  
  .victory-history-list::-webkit-scrollbar {
    width: 4px;
  }
  
  .victory-history-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }
</style>

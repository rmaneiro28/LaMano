---
// Header.astro - Barra superior con logo oficial Wicho Domino Club y controles
---

<header class="app-header">
  <div class="header-brand" id="btn-replay-intro" title="Wicho Domino Club (Toca para ver video de bienvenida)" role="button" tabindex="0">
    <div class="logo-circle-container">
      <img src="./logo.png" alt="Wicho Domino Club" class="header-brand-logo" />
    </div>
    <div class="header-brand-texts">
      <div class="header-title-row">
        <h1 class="header-title">WICHO</h1>
        <span class="header-badge-club">CLUB</span>
      </div>
      <span class="header-subtitle">Dominó por Parejas</span>
    </div>
  </div>

  <div class="header-actions">
    <!-- Botón Pantalla Activa (Wake Lock) -->
    <button
      id="btn-wake-lock"
      class="header-btn"
      title="Mantener pantalla activa durante la partida"
      aria-label="Pantalla siempre activa"
    >
      <span class="btn-icon-symbol" id="wake-lock-icon">☀️</span>
      <span class="status-dot" id="wake-lock-dot"></span>
    </button>

    <!-- Botón Sonido Mute/Unmute -->
    <button
      id="btn-audio-toggle"
      class="header-btn"
      title="Activar / Desactivar sonido"
      aria-label="Sonido"
    >
      <span class="btn-icon-symbol" id="audio-icon">🔊</span>
    </button>

    <!-- Botón Ajustes / Setup -->
    <button
      id="btn-open-setup"
      class="header-btn"
      title="Configurar partida y reglas"
      aria-label="Configuración de mesa"
    >
      <span class="btn-icon-symbol">⚙️</span>
    </button>
  </div>
</header>

<style>
  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.25rem 0.65rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
    outline: none;
    border-radius: var(--radius-sm);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .header-brand:hover {
    opacity: 0.92;
  }

  .header-brand:active {
    transform: scale(0.97);
  }

  .logo-circle-container {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--mano-gold);
    box-shadow: 0 0 10px var(--mano-glow);
    background: #0d1a16;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .header-brand-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .header-brand-texts {
    display: flex;
    flex-direction: column;
  }

  .header-title-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1.1;
  }

  .header-title {
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--text-main);
    letter-spacing: 0.02em;
  }

  .header-badge-club {
    font-size: 0.62rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--mano-gold) 0%, #d97706 100%);
    color: #0b1411;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .header-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .header-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .header-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .header-btn.active {
    border-color: var(--mano-gold);
    background: rgba(251, 191, 36, 0.15);
  }

  .btn-icon-symbol {
    font-size: 1.05rem;
    line-height: 1;
  }

  .status-dot {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #64748b;
  }

  .status-dot.active {
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }
</style>

<script>
  // Permitir volver a ver el video de bienvenida tocando el logo
  const brandBtn = document.getElementById('btn-replay-intro');
  if (brandBtn) {
    brandBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('lamano:replay-intro'));
    });
  }
</script>

---
// SetupModal.astro - Configuración de equipos, jugadores y modalidad de serie
---

<div class="modal-overlay" id="setup-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title-setup">
  <div class="modal-sheet setup-sheet">
    <div class="sheet-handle"></div>

    <div class="modal-header">
      <div>
        <h2 id="modal-title-setup">Configuración de Mesa</h2>
        <p class="modal-subtitle">Wicho Domino Club • 100 Puntos • Antihorario</p>
      </div>
      <button class="btn-icon close-modal-btn" id="btn-close-setup" aria-label="Cerrar">✕</button>
    </div>

    <form id="setup-form" class="setup-form">
      <!-- 1. Modalidad de Serie -->
      <div class="setup-section match-mode-section">
        <div class="section-title-with-badge">
          <span class="mano-icon">🏆</span>
          <div>
            <h3 class="setup-section-title">Modalidad de Serie</h3>
            <span class="section-required-badge">Requerido</span>
          </div>
        </div>

        <div class="match-mode-grid">
          <!-- Bo3 -->
          <button type="button" class="match-mode-btn active" id="mode-btn-bo3" data-mode="bo3" aria-pressed="true">
            <div class="mode-trophy-row">
              <span class="mode-trophy filled">🏆</span>
              <span class="mode-trophy filled">🏆</span>
              <span class="mode-trophy empty">🥈</span>
            </div>
            <strong class="mode-label">Mejor de 3</strong>
            <span class="mode-wins-needed">Primero en ganar <em>2 partidas</em></span>
            <div class="mode-selected-pill">✓ Seleccionado</div>
          </button>

          <!-- Bo5 -->
          <button type="button" class="match-mode-btn" id="mode-btn-bo5" data-mode="bo5" aria-pressed="false">
            <div class="mode-trophy-row">
              <span class="mode-trophy filled">🏆</span>
              <span class="mode-trophy filled">🏆</span>
              <span class="mode-trophy filled">🏆</span>
              <span class="mode-trophy empty">🥈</span>
              <span class="mode-trophy empty">🥈</span>
            </div>
            <strong class="mode-label">Mejor de 5</strong>
            <span class="mode-wins-needed">Primero en ganar <em>3 partidas</em></span>
            <div class="mode-selected-pill">✓ Seleccionado</div>
          </button>
        </div>
      </div>

      <!-- 2. Equipos -->
      <div class="setup-section">
        <h3 class="setup-section-title">Equipos</h3>
        <div class="setup-grid-2">
          <div class="input-group team-a-input">
            <label for="setup-team-a-name" class="input-label">
              <span class="team-dot dot-a"></span>
              <span>Equipo A</span>
            </label>
            <input
              type="text"
              id="setup-team-a-name"
              class="text-input"
              value="Nosotros"
              placeholder="Ej. Nosotros"
              required
            />
          </div>

          <div class="input-group team-b-input">
            <label for="setup-team-b-name" class="input-label">
              <span class="team-dot dot-b"></span>
              <span>Equipo B</span>
            </label>
            <input
              type="text"
              id="setup-team-b-name"
              class="text-input"
              value="Ellos"
              placeholder="Ej. Ellos"
              required
            />
          </div>
        </div>
      </div>

      <!-- 3. Jugadores -->
      <div class="setup-section">
        <h3 class="setup-section-title">Jugadores (Posiciones en Mesa)</h3>
        <p class="section-description">Rotación continua antihoraria:</p>

        <div class="setup-grid-2">
          <!-- Asiento 0: Sur (Equipo A) -->
          <div class="input-group seat-group-south">
            <label for="setup-player-0" class="input-label">
              <span class="seat-index-badge badge-a">Jugador 1 (Sur - Eq A)</span>
            </label>
            <input type="text" id="setup-player-0" class="text-input player-name-input" data-seat="0" value="Jugador 1" placeholder="Nombre Jugador 1" required />
          </div>

          <!-- Asiento 1: Este (Equipo B) -->
          <div class="input-group seat-group-east">
            <label for="setup-player-1" class="input-label">
              <span class="seat-index-badge badge-b">Jugador 2 (Este - Eq B)</span>
            </label>
            <input type="text" id="setup-player-1" class="text-input player-name-input" data-seat="1" value="Jugador 2" placeholder="Nombre Jugador 2" required />
          </div>

          <!-- Asiento 2: Norte (Equipo A) -->
          <div class="input-group seat-group-north">
            <label for="setup-player-2" class="input-label">
              <span class="seat-index-badge badge-a">Jugador 3 (Norte - Eq A)</span>
            </label>
            <input type="text" id="setup-player-2" class="text-input player-name-input" data-seat="2" value="Jugador 3" placeholder="Nombre Jugador 3" required />
          </div>

          <!-- Asiento 3: Oeste (Equipo B) -->
          <div class="input-group seat-group-west">
            <label for="setup-player-3" class="input-label">
              <span class="seat-index-badge badge-b">Jugador 4 (Oeste - Eq B)</span>
            </label>
            <input type="text" id="setup-player-3" class="text-input player-name-input" data-seat="3" value="Jugador 4" placeholder="Nombre Jugador 4" required />
          </div>
        </div>
      </div>

      <!-- Aviso de salidor -->
      <div class="starter-reminder">
        <span class="starter-reminder-icon">✋</span>
        <span>El salidor de la 1ª partida se elige <strong>tocando directamente al jugador en la mesa</strong></span>
      </div>

      <!-- Reglas fijas informativas -->
      <div class="rules-fixed-info">
        <div class="rule-chip">
          <span>🎯</span>
          <span>Meta: <strong>100 pts</strong></span>
        </div>
        <div class="rule-chip">
          <span>↺</span>
          <span>Sentido: <strong>Antihorario</strong></span>
        </div>
        <div class="rule-chip">
          <span>🔄</span>
          <span>Salidas: <strong>Rotación Continua</strong></span>
        </div>
      </div>

      <!-- Botón de Inicio / Guardar -->
      <button type="submit" class="btn btn-primary btn-save-setup" id="btn-save-setup">
        <span>Comenzar Serie</span>
      </button>
    </form>
  </div>
</div>

<style>
  .setup-sheet {
    max-height: 90vh;
  }

  .setup-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .setup-section {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem;
  }

  .match-mode-section {
    background: rgba(251, 191, 36, 0.04);
    border: 1.5px solid rgba(251, 191, 36, 0.3);
  }

  .section-title-with-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mano-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .section-required-badge {
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--mano-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .setup-section-title {
    font-size: 0.95rem;
    color: var(--mano-gold);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .section-description {
    font-size: 0.73rem;
    color: var(--text-muted);
  }

  /* Match Mode Selector — Premium Cards */
  .match-mode-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .match-mode-btn {
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1rem 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .match-mode-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(251, 191, 36, 0.04) 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .match-mode-btn:hover::before {
    opacity: 1;
  }

  .match-mode-btn:hover {
    border-color: rgba(251, 191, 36, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .match-mode-btn.active {
    border-color: var(--mano-gold);
    background: rgba(251, 191, 36, 0.1);
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.2), 0 4px 16px rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
  }

  .match-mode-btn.active::before {
    opacity: 1;
  }

  /* Fila de trofeos */
  .mode-trophy-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    flex-wrap: wrap;
    margin-bottom: 0.15rem;
  }

  .mode-trophy {
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .mode-trophy.filled {
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.5));
  }

  .mode-trophy.empty {
    filter: grayscale(100%) opacity(0.35);
  }

  .match-mode-btn.active .mode-trophy.filled {
    filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.75));
    animation: trophyPulse 2s infinite;
  }

  @keyframes trophyPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  .mode-label {
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-main);
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .match-mode-btn.active .mode-label {
    color: var(--mano-gold);
  }

  .mode-wins-needed {
    font-size: 0.68rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .mode-wins-needed em {
    font-style: normal;
    font-weight: 800;
    color: var(--text-main);
  }

  .match-mode-btn.active .mode-wins-needed em {
    color: var(--mano-gold);
  }

  /* Pill de selección activa */
  .mode-selected-pill {
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--mano-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.55rem;
    opacity: 0;
    transform: scale(0.85);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 0.1rem;
  }

  .match-mode-btn.active .mode-selected-pill {
    opacity: 1;
    transform: scale(1);
  }

  .setup-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .input-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .text-input {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.65rem;
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .text-input:focus {
    border-color: var(--mano-gold);
  }

  /* Grid en Cruz para Jugadores */
  .players-cross-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cross-middle-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .seat-index-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-full);
  }

  .seat-index-badge.badge-a {
    background: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
  }

  .seat-index-badge.badge-b {
    background: rgba(249, 115, 22, 0.2);
    color: #fdba74;
  }

  /* Recordatorio de salidor */
  .starter-reminder {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: rgba(251, 191, 36, 0.07);
    border: 1px dashed rgba(251, 191, 36, 0.35);
    border-radius: var(--radius-md);
    padding: 0.65rem 0.75rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .starter-reminder-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .starter-reminder strong {
    color: var(--mano-gold);
  }

  /* Barra de Reglas Fijas */
  .rules-fixed-info {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    gap: 0.35rem;
  }

  .rule-chip {
    font-size: 0.68rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .rule-chip strong {
    color: var(--text-main);
  }

  .btn-save-setup {
    height: 50px;
    font-size: 1.05rem;
    margin-top: 0.25rem;
  }
</style>

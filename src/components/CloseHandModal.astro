---
// CloseHandModal.astro - Formulario modal táctil de registro de mano
---

<div class="modal-overlay" id="close-hand-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title-close">
  <div class="modal-sheet">
    <div class="sheet-handle"></div>

    <div class="modal-header">
      <div>
        <h2 id="modal-title-close">Cerrar Mano Actual</h2>
        <p class="modal-subtitle" id="modal-subtitle-round">Ronda 1</p>
      </div>
      <button class="btn-icon close-modal-btn" id="btn-cancel-close-hand" aria-label="Cancelar">✕</button>
    </div>

    <!-- Salidor actual (solo info) -->
    <div class="starter-info-banner">
      <span class="starter-info-icon">✋</span>
      <span>Sale: <strong id="modal-current-starter-name">—</strong></span>
    </div>

    <!-- PASO 1: Selector de Tipo de Victoria -->
    <div class="form-section">
      <div class="step-header">
        <span class="step-num-badge">1</span>
        <label class="section-label">Tipo de Victoria</label>
      </div>
      <div class="segment-control">
        <button type="button" class="segment-btn active" id="btn-win-normal" data-type="normal">
          <span class="segment-icon">🀰</span>
          <span>Dominada Normal</span>
        </button>
        <button type="button" class="segment-btn" id="btn-win-tranca" data-type="tranca">
          <span class="segment-icon">🔒</span>
          <span>Tranca / Cierre</span>
        </button>
      </div>
    </div>

    <!-- PASO 2: Selector de Ganador -->
    <!-- Vista A: Si es Dominada Normal -> Selección de Jugador Individual -->
    <div class="form-section" id="section-winner-player">
      <div class="step-header">
        <span class="step-num-badge">2</span>
        <label class="section-label">¿Quién dominó la mano?</label>
      </div>
      <div class="player-selection-grid">
        <button type="button" class="player-select-btn" data-seat="0" id="btn-select-seat-0">
          <span class="seat-team-dot dot-a"></span>
          <span class="select-player-name" id="select-name-0">Jugador 1</span>
          <span class="select-team-tag">Nosotros</span>
        </button>
        <button type="button" class="player-select-btn" data-seat="1" id="btn-select-seat-1">
          <span class="seat-team-dot dot-b"></span>
          <span class="select-player-name" id="select-name-1">Jugador 2</span>
          <span class="select-team-tag">Ellos</span>
        </button>
        <button type="button" class="player-select-btn" data-seat="2" id="btn-select-seat-2">
          <span class="seat-team-dot dot-a"></span>
          <span class="select-player-name" id="select-name-2">Jugador 3</span>
          <span class="select-team-tag">Nosotros</span>
        </button>
        <button type="button" class="player-select-btn" data-seat="3" id="btn-select-seat-3">
          <span class="seat-team-dot dot-b"></span>
          <span class="select-player-name" id="select-name-3">Jugador 4</span>
          <span class="select-team-tag">Ellos</span>
        </button>
      </div>
    </div>

    <!-- Vista B: Si es Tranca -> Selección de Pareja Ganadora del Conteo -->
    <div class="form-section hidden" id="section-winner-team">
      <div class="step-header">
        <span class="step-num-badge">2</span>
        <label class="section-label">Pareja ganadora del conteo:</label>
      </div>
      <div class="team-selection-grid">
        <button type="button" class="team-select-btn team-a" data-team="teamA" id="btn-select-team-a">
          <span class="team-select-indicator">🔵</span>
          <span class="team-select-name" id="select-team-a-name">Nosotros</span>
        </button>
        <button type="button" class="team-select-btn team-b" data-team="teamB" id="btn-select-team-b">
          <span class="team-select-indicator">🟠</span>
          <span class="team-select-name" id="select-team-b-name">Ellos</span>
        </button>
      </div>
    </div>

    <!-- PASO 3: Entrada de Puntos -->
    <div class="form-section points-section">
      <div class="points-header">
        <div class="step-header">
          <span class="step-num-badge">3</span>
          <label class="section-label">Puntos de la mano</label>
        </div>
        <div class="points-display-box">
          <span class="points-value tabular-nums" id="input-points-display">0</span>
          <span class="points-unit">pts</span>
        </div>
      </div>

      <!-- Chips de suma rápida -->
      <div class="quick-add-row">
        <button type="button" class="quick-chip" data-add="5">+5</button>
        <button type="button" class="quick-chip" data-add="10">+10</button>
        <button type="button" class="quick-chip" data-add="20">+20</button>
        <button type="button" class="quick-chip" data-add="30">+30</button>
        <button type="button" class="quick-chip" data-add="50">+50</button>
      </div>

      <!-- Keypad táctil numérico -->
      <div class="keypad-grid">
        <button type="button" class="keypad-btn" data-num="1">1</button>
        <button type="button" class="keypad-btn" data-num="2">2</button>
        <button type="button" class="keypad-btn" data-num="3">3</button>
        <button type="button" class="keypad-btn" data-num="4">4</button>
        <button type="button" class="keypad-btn" data-num="5">5</button>
        <button type="button" class="keypad-btn" data-num="6">6</button>
        <button type="button" class="keypad-btn" data-num="7">7</button>
        <button type="button" class="keypad-btn" data-num="8">8</button>
        <button type="button" class="keypad-btn" data-num="9">9</button>
        <button type="button" class="keypad-btn action-btn" id="btn-keypad-clear">C</button>
        <button type="button" class="keypad-btn" data-num="0">0</button>
        <button type="button" class="keypad-btn action-btn" id="btn-keypad-backspace">⌫</button>
      </div>
    </div>

    <!-- Previsualización del Impacto -->
    <div class="preview-impact-box" id="preview-impact">
      <span class="preview-icon">ℹ️</span>
      <span class="preview-text" id="preview-text">Selecciona quién ganó y anota los puntos de la mano</span>
    </div>

    <!-- Botón Confirmar -->
    <button type="button" class="btn btn-primary btn-save-hand" id="btn-submit-hand">
      <span>Confirmar y Guardar Mano</span>
    </button>
  </div>
</div>

<style>
  .modal-subtitle {
    font-size: 0.8rem;
    color: var(--mano-gold);
    font-weight: 700;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* Banner informativo de salidor actual */
  .starter-info-banner {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.7rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .starter-info-icon {
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .starter-info-banner strong {
    color: #93c5fd;
    font-weight: 800;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .step-num-badge {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--mano-gold);
    color: #0b1411;
    font-size: 0.65rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step-required-tag {
    margin-left: auto;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--mano-gold);
    text-transform: uppercase;
    background: rgba(251, 191, 36, 0.15);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Selector Segmentado */
  .segment-control {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: rgba(0, 0, 0, 0.35);
    padding: 0.3rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    gap: 0.35rem;
  }

  .segment-btn {
    padding: 0.55rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }

  .segment-btn.active {
    background: var(--bg-surface-elevated);
    color: var(--text-main);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .segment-icon {
    font-size: 1.1rem;
  }

  /* Grids de Selección */
  .player-selection-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .player-select-btn {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.45rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    text-align: left;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .player-select-btn.selected {
    border-color: var(--mano-gold);
    background: rgba(251, 191, 36, 0.12);
    box-shadow: 0 0 10px rgba(251, 191, 36, 0.25);
  }

  .starter-opt-btn.selected {
    border-color: #60a5fa;
    background: rgba(59, 130, 246, 0.16);
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.25);
  }

  .seat-team-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .select-player-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .select-team-tag {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .team-selection-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .team-select-btn {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.8rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-main);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .team-select-btn.team-a.selected {
    border-color: var(--team-a-base);
    background: var(--team-a-bg);
    box-shadow: 0 0 12px var(--team-a-glow);
  }

  .team-select-btn.team-b.selected {
    border-color: var(--team-b-base);
    background: var(--team-b-bg);
    box-shadow: 0 0 12px var(--team-b-glow);
  }

  /* Sección de Puntos */
  .points-section {
    gap: 0.6rem;
  }

  .points-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .points-display-box {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--mano-gold);
    box-shadow: 0 0 12px rgba(251, 191, 36, 0.2);
  }

  .points-value {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 900;
    color: var(--mano-gold);
    line-height: 1;
  }

  .points-unit {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  /* Chips Rápidos */
  .quick-add-row {
    display: flex;
    gap: 0.35rem;
  }

  .quick-chip {
    flex: 1;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.2rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
    transition: all 0.12s ease;
  }

  .quick-chip:active {
    background: var(--mano-gold);
    color: #000;
    transform: scale(0.95);
  }

  /* Keypad */
  .keypad-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .keypad-btn {
    height: 44px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.1s ease, transform 0.1s ease;
  }

  .keypad-btn:active {
    background: rgba(255, 255, 255, 0.15);
    transform: scale(0.96);
  }

  .action-btn {
    background: rgba(0, 0, 0, 0.3);
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  /* Previsualización */
  .preview-impact-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.75rem;
  }

  .preview-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .preview-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .btn-save-hand {
    height: 50px;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    margin-top: 0.2rem;
  }

  .hidden {
    display: none !important;
  }
</style>

---
// index.astro - Página Principal de Wicho´s Domino Club
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ScoreBoard from '../components/ScoreBoard.astro';
import DominoTable from '../components/DominoTable.astro';
import RoundControls from '../components/RoundControls.astro';
import CloseHandModal from '../components/CloseHandModal.astro';
import HistoryDrawer from '../components/HistoryDrawer.astro';
import SetupModal from '../components/SetupModal.astro';
import VictoryModal from '../components/VictoryModal.astro';
import IntroSplash from '../components/IntroSplash.astro';
---

<Layout>
  <!-- Animación y Video de Entrada Wicho´s Domino Club -->
  <IntroSplash />

  <main class="app-container">
    <!-- Barra Superior con Logo Oficial -->
    <Header />

    <!-- Marcador de Anotación Manual en Dos Columnas -->
    <ScoreBoard />

    <!-- Mesa de Dominó con Representación Gráfica e Indicador de "La Mano" -->
    <DominoTable />

    <!-- Controles Rápidos de Mesa -->
    <RoundControls />

    <!-- Modales y Drawers -->
    <CloseHandModal />
    <HistoryDrawer />
    <SetupModal />
    <VictoryModal />
  </main>

  <script>
    import { initApp } from '../scripts/app';

    // Inicializar la aplicación una vez que el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initApp());
    } else {
      initApp();
    }
  </script>
</Layout>
